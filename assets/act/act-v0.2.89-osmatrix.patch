+func artifactV4ContentType(body []byte) string {
+	// The proto3 JSON mapping allows the field name (mime_type) and its lowerCamelCase form (mimeType).
+	var request struct {
+		MimeType      string `json:"mime_type"`
+		MimeTypeCamel string `json:"mimeType"`
+	}
+	if err := json.Unmarshal(body, &request); err != nil {
+		return ArtifactV4ContentEncoding
+	}
+	mimeType := request.MimeType
+	if mimeType == "" {
+		mimeType = request.MimeTypeCamel
+	}
+	if mimeType == "" {
+		return ArtifactV4ContentEncoding
+	}
+	if _, _, err := mime.ParseMediaType(mimeType); err != nil {
+		return ArtifactV4ContentEncoding
+	}
+	return mimeType
+}
