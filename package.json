{
  "name": "osmatrix",
  "version": "0.2.0",
  "description": "Local Ubuntu/Windows/macOS environments and GitHub Actions matrix runs (via act) for coding agents. CLI + MCP server + skill.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "osmatrix": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/container",
    "assets/oem",
    "assets/provision",
    "assets/macos",
    "assets/qemu",
    "README.md",
    "skills",
    "LICENSE",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "mcp",
    "act",
    "github-actions",
    "agents",
    "dockur",
    "windows",
    "macos",
    "claude",
    "cursor",
    "codex"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "dev": "node src/cli.ts",
    "prepack": "npm run build",
    "sync": "node scripts/sync-manifests.mjs",
    "validate": "node scripts/sync-manifests.mjs --check && node scripts/validate-skills.mjs && node scripts/validate-plugins.mjs && node scripts/validate-workflows.mjs",
    "package:plugins": "npm run validate && node scripts/package-plugins.mjs",
    "codeql": "node scripts/codeql.mjs",
    "check": "npm run typecheck && npm test && npm run validate",
    "ci:local": "node src/cli.ts ci run --repo . -W ci.yml --wait",
    "ci:local:linux": "node src/cli.ts ci run --repo . -W ci.yml --only linux --wait",
    "release:rehearse": "node scripts/release-rehearse.mjs",
    "verify": "npm run check && npm run codeql && npm run ci:local",
    "release:tag": "node scripts/release-tag.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fritz-fritz/osmatrix.git"
  },
  "homepage": "https://github.com/fritz-fritz/osmatrix"
}
